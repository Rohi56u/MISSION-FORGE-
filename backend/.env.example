# ==============================================================================
# Mission Forge Backend — Environment Configuration Template (.env.example)
# NASA Space Apps Challenge 2026
# Copy this file to .env and provide your deployment-specific settings.
# DO NOT COMMIT ACTUAL API KEYS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Mission Forge Aerospace API"
VERSION="1.0.0"
ENVIRONMENT=development                   # Options: development | test | production
DEBUG=true                                # Must be false in production
LOG_LEVEL=INFO                            # Options: DEBUG | INFO | WARNING | ERROR

# --- Security & Authentication (Phase 4 & Firebase Integration) ---
# Generate a cryptographically secure 256-bit key for local JWT fallback:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080         # Token lifetime in minutes (default: 7 days)
ALLOW_CATALOG_MUTATION_WITHOUT_AUTH=true  # Automatically forced to false in production

# --- Firebase Authentication Integration ---
# Official Firebase Identity Provider settings:
FIREBASE_PROJECT_ID=                      # e.g. mission-forge-2026
FIREBASE_CREDENTIALS_PATH=                # Path to serviceAccountKey.json (keep outside git)
# Alternatively, inline credentials for cloud deployments:
FIREBASE_CLIENT_EMAIL=                    # e.g. firebase-adminsdk-xxx@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=                     # PEM private key with \n preserved

# --- Supabase Integration (PostgreSQL & Object Storage) ---
# Primary Relational Persistence (Supabase PostgreSQL):
# Direct connection (Session Mode, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
# Connection Pooler (Transaction Mode, port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Supabase Object Storage for Mission Dossiers:
SUPABASE_URL=                             # e.g. https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=                             # Supabase anon or service-role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=                # Supabase service role key for storage administration
SUPABASE_STORAGE_BUCKET=dossiers          # Private bucket name for dossier PDF/JSON artifacts
SUPABASE_STORAGE_EXPIRING_URL_SECONDS=3600 # Signed download URL TTL in seconds (default: 1 hour)

# --- CORS (Cross-Origin Resource Sharing) ---
# JSON array of trusted frontend origin URLs (wildcard '*' is rejected when credentials are true)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Database & Persistence ---
# SQLite async driver for local development & automated CI test suites:
DATABASE_URL=sqlite+aiosqlite:///./mission_forge.db
# PostgreSQL async driver for production container deployments:
# DATABASE_URL=postgresql+asyncpg://forge_user:forge_password@postgres:5432/mission_forge
DATABASE_ECHO=false

# --- External Aerospace Data Integrations (Phase 2) ---
# NASA Open Data APIs — Obtain free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY
NASA_API_BASE_URL=https://api.nasa.gov
HORIZONS_API_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
DSN_FEED_URL=https://eyes.nasa.gov/dsn/data/dsn.xml
TECHPORT_API_BASE_URL=https://techport.nasa.gov/api
EXTERNAL_API_TIMEOUT_SECONDS=15.0
EXTERNAL_API_MAX_RETRIES=3

# --- Grounded CAPCOM AI Assistant (Phase 5) ---
# Google Gemini API Key — Obtain at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Distributed Broker for Real-time Collaboration (Phase 4) ---
# Redis pub/sub broker URL for multi-officer CDF synchronization
REDIS_URL=redis://localhost:6379/0

# --- Astrodynamics & Physics Solver Parameters (Phase 3) ---
LAMBERT_MAX_ITERATIONS=100
LAMBERT_TOLERANCE=1e-6
PORKCHOP_DEFAULT_GRID_SIZE=30

# --- Mission Dossier Generation & Storage Hardening (Phase 6) ---
DOSSIER_STORAGE_DIR=artifacts/dossiers   # Persistent directory path for generated PDF and JSON exports
DOSSIER_MAX_CONCURRENT_JOBS=2          # Maximum concurrent background dossier compiler workers
DOSSIER_RETENTION_DAYS=30              # Retention window in days for generated dossier artifacts
DOSSIER_MAX_TITLE_LENGTH=128           # Title character limit for sanitization and layout defense
MAX_REQUEST_BODY_BYTES=10485760        # Maximum HTTP request body size (10 MB) to mitigate DoS attacks
